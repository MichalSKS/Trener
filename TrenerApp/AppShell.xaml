<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TrenerApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TrenerApp.Views"
    Title="Trenér">

    <!-- Spodní navigační lišta podle návrhu -->
    <TabBar>
        <ShellContent
            Title="Domů"
            Icon="ic_tab_home.png"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />

        <ShellContent
            Title="Soupiska"
            Icon="ic_tab_roster.png"
            ContentTemplate="{DataTemplate views:RosterPage}"
            Route="roster" />

        <ShellContent
            Title="Tréninky"
            Icon="ic_tab_trainings.png"
            ContentTemplate="{DataTemplate views:TrainingsPage}"
            Route="trainings" />

        <ShellContent
            Title="Zápasy"
            Icon="ic_tab_matches.png"
            ContentTemplate="{DataTemplate views:MatchesPage}"
            Route="matches" />
    </TabBar>

</Shell>
