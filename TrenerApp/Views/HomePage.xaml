<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrenerApp.Views.HomePage"
             Shell.NavBarIsVisible="False"
             Title="Domů">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,24" Spacing="6">

            <!-- Hlavička -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="TRENÉRSKÝ ZÁPISNÍK" Style="{StaticResource Overline}" VerticalOptions="Center" />
                <Border Grid.Column="1"
                        WidthRequest="42"
                        HeightRequest="42"
                        BackgroundColor="{StaticResource Secondary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10">
                    <Image Source="ic_shield_green.png" WidthRequest="22" HeightRequest="22" />
                </Border>
            </Grid>
            <Label x:Name="TeamLabel" Style="{StaticResource PageTitle}" FontSize="32" />
            <Label x:Name="SubtitleLabel" Style="{StaticResource PageSubtitle}" />

            <!-- Dlaždice s hlavními částmi aplikace -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="170,170"
                  ColumnSpacing="12"
                  RowSpacing="12"
                  Margin="0,22,0,0">

                <Border BackgroundColor="{StaticResource TileGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRosterTapped" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <Image Source="ic_tile_roster.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start" />
                        <Image Source="ic_arrow_white.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="End" VerticalOptions="Start" />
                        <Label Grid.Row="2" Text="Soupiska" FontSize="22" FontFamily="OpenSansSemibold" TextColor="White" />
                        <Label x:Name="RosterCountLabel" Grid.Row="3" FontSize="13" TextColor="#D5E6DB" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" BackgroundColor="{StaticResource TileMint}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrainingsTapped" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <Image Source="ic_tile_trainings.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start" />
                        <Image Source="ic_arrow_green.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="End" VerticalOptions="Start" />
                        <Label Grid.Row="2" Text="Tréninky" FontSize="22" FontFamily="OpenSansSemibold" TextColor="{StaticResource Tertiary}" />
                        <Label Grid.Row="3" Text="Docházka a cvičení" FontSize="13" TextColor="{StaticResource Tertiary}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" BackgroundColor="{StaticResource TileSlate}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMatchesTapped" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <Image Source="ic_tile_matches.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start" />
                        <Image Source="ic_arrow_slate.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="End" VerticalOptions="Start" />
                        <Label Grid.Row="2" Text="Zápasy" FontSize="22" FontFamily="OpenSansSemibold" TextColor="{StaticResource TileSlateText}" />
                        <Label Grid.Row="3" Text="Výsledky a hodnocení" FontSize="13" TextColor="{StaticResource TileSlateText}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{StaticResource TileSand}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrainingsTapped" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <Image Source="ic_tile_timer.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start" />
                        <Image Source="ic_arrow_sand.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="End" VerticalOptions="Start" />
                        <Label Grid.Row="2" Text="Katalog a časovač" FontSize="20" FontFamily="OpenSansSemibold" TextColor="{StaticResource TileSandText}" />
                        <Label Grid.Row="3" Text="Cvičení pod kontrolou" FontSize="13" TextColor="{StaticResource TileSandText}" />
                    </Grid>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
